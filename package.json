{
  "name": "signal-ecogaz-card",
  "version": "0.1.0",
  "description": "Lovelace card for the Home Assistant signal_ecogaz integration (RTE ÉcoGaz signal)",
  "type": "module",
  "module": "dist/signal-ecogaz-card.js",
  "main": "dist/signal-ecogaz-card.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/homeassistant-fr-ecosystem/signal-ecogaz-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "signal-ecogaz",
    "ecogaz",
    "rte"
  ],
  "scripts": {
