    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lit": "^3.3.3",
    "rollup": "^4.68.6",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "@playwright/test": "^1.65.1",
